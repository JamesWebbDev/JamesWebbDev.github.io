    <colours>
        <primary>rgb(0, 215, 143)</primary>
        <secondary>rgb(0, 51, 52)</secondary>
        <tertiary>rgb(2, 20, 30)</tertiary>
        <surface>rgb(30, 30, 30)</surface>
        <onsurface>rgb(240, 240, 240)</onsurface>
    </colours>
</project>